# =============================================================================
# Real Estate Lead Bot — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit the real .env file.
# =============================================================================

# Application
APP_ENV=development
APP_NAME=real-estate-lead-bot
DEBUG=true
LOG_LEVEL=INFO

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/real_estate_leads

# Security / Auth
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SERVICE_TOKEN=change-me-service-to-service-token

# n8n
N8N_WEBHOOK_URL=http://localhost:5678/webhook/lead-process-message
N8N_WEBHOOK_SECRET=change-me-n8n-webhook-secret
N8N_BASE_URL=http://localhost:5678

# AI Provider
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30

# Google Sheets (optional)
GOOGLE_SHEETS_CREDENTIALS=
GOOGLE_SHEETS_SPREADSHEET_ID=

# Notifications (optional)
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
